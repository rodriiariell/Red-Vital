{
  "name": "@redvital/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace=@redvital/domain && tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "npm run build --workspace=@redvital/domain && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:init:sqlite": "node scripts/init-sqlite.mjs",
    "db:validate": "prisma validate",
    "db:check": "tsx src/check-database.ts",
    "test": "npm run build && vitest run --config vitest.config.mjs --configLoader runner --testTimeout=20000"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@redvital/domain": "*",
    "argon2": "^0.45.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.2",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.4",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
