# SQLite para desarrollo local. PostgreSQL queda reservado para producción futura.
DATABASE_URL="file:./prisma/dev.db"
PASSWORD_HASHER="scrypt"

# API
NODE_ENV="development"
API_HOST="127.0.0.1"
API_PORT="3001"
CORS_ORIGIN="http://localhost:8000"

# Reservados para la futura autenticacion; nunca usar estos valores en produccion.
AUTH_ACCESS_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AUTH_REFRESH_TOKEN_SECRET="replace-with-at-least-32-random-characters"
AUTH_ACCESS_TOKEN_TTL="15m"
AUTH_REFRESH_TOKEN_TTL="30d"
AUTH_PASSWORD_RESET_TTL="1h"
AUTH_COOKIE_NAME="redvital_refresh"
AUTH_ACCESS_COOKIE_NAME="redvital_access"
